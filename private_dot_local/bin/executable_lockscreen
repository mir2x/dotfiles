#!/usr/bin/env bash
# Fast lock using the pre-rendered cached image (see lockscreen-render).
if [ -n "$WAYLAND_DISPLAY" ]; then
  exec swaylock -f -i /home/mir/.local/share/backgrounds/lockscreen-fancy.png
fi
exec i3lock -i /home/mir/.local/share/backgrounds/lockscreen-fancy.png \
  --inside-color=00000000 --ring-color=00000000 --line-color=00000000 \
  --keyhl-color=00000000 --bshl-color=00000000 --separator-color=00000000 \
  --insidever-color=00000000 --ringver-color=00000000 \
  --insidewrong-color=00000000 --ringwrong-color=00000000 \
  --verif-color=00000000 --wrong-color=00000000 --time-color=00000000 \
  --date-color=00000000 --layout-color=00000000
